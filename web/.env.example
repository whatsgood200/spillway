# Copy to .env.local. Names only; never commit values.
# "real" reads Base Sepolia; "mock" runs the in-browser simulation (development only).
NEXT_PUBLIC_CHAIN_ADAPTER=real
# Optional: a Base Sepolia RPC with higher limits than the public one.
NEXT_PUBLIC_BASE_SEPOLIA_RPC=
# Throwaway testnet key for the demo console. Create it with: node scripts/create-demo-wallet.mjs
DEMO_PRIVATE_KEY=
